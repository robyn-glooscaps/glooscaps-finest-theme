<main class="gf-contact">
  <section class="gf-contact__hero">
    <div class="gf-contact__inner">
      <p class="gf-contact__kicker">{{ section.settings.kicker }}</p>
      <h1>{{ page.title | default: section.settings.heading }}</h1>
      <p>{{ section.settings.intro }}</p>
    </div>
  </section>

  <section class="gf-contact__body">
    <div class="gf-contact__details">
      <h2>{{ section.settings.connect_heading }}</h2>
      <p>{{ section.settings.connect_text }}</p>
      <div class="gf-contact__links">
        <a href="{{ section.settings.linktree_url | escape }}" target="_blank" rel="noopener">Linktree</a>
        <a href="{{ section.settings.facebook_url | escape }}" target="_blank" rel="noopener">Facebook</a>
        <a href="{{ section.settings.instagram_url | escape }}" target="_blank" rel="noopener">Instagram</a>
        <a href="{{ section.settings.tiktok_url | escape }}" target="_blank" rel="noopener">TikTok</a>
        <a href="{{ section.settings.smoke_harbour_url | escape }}" target="_blank" rel="noopener">Smoke Harbour</a>
      </div>
    </div>

    <div class="gf-contact__form">
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="gf-contact__success">{{ section.settings.success_message }}</p>
        {% endif %}
        {{ form.errors | default_errors }}
        <label for="ContactFormName">{{ section.settings.name_label }}</label>
        <input id="ContactFormName" type="text" name="contact[name]" autocomplete="name">
        <label for="ContactFormEmail">{{ section.settings.email_label }}</label>
        <input id="ContactFormEmail" type="email" name="contact[email]" autocomplete="email" required>
        <label for="ContactFormMessage">{{ section.settings.message_label }}</label>
        <textarea id="ContactFormMessage" name="contact[body]" rows="6" required></textarea>
        <button type="submit">{{ section.settings.submit_label }}</button>
      {% endform %}
    </div>
  </section>
</main>

{% stylesheet %}
  .gf-contact {
    color: #2e2a24;
    background: #faf7f1;
  }

  .gf-contact__hero {
    color: #faf7f1;
    background: #24382d;
    padding: clamp(64px, 10vw, 118px) 0;
  }

  .gf-contact__inner,
  .gf-contact__body {
    width: min(1100px, calc(100% - 32px));
    margin: 0 auto;
  }

  .gf-contact__hero h1 {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .gf-contact__hero p:last-child {
    max-width: 660px;
    margin: 20px 0 0;
    line-height: 1.6;
  }

  .gf-contact__kicker {
    margin: 0 0 12px;
    color: #d7b24a;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
  }

  .gf-contact__body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(320px, 1.2fr);
    gap: 44px;
    padding: clamp(48px, 8vw, 84px) 0;
  }

  .gf-contact__details h2 {
    margin: 0 0 12px;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0;
  }

  .gf-contact__details p {
    margin: 0 0 24px;
    color: #5a5147;
    line-height: 1.65;
  }

  .gf-contact__links {
    display: grid;
    border-top: 2px solid #24382d;
  }

  .gf-contact__links a {
    display: flex;
    align-items: center;
    min-height: 50px;
    color: #24382d;
    text-decoration: none;
    border-bottom: 1px solid rgba(47, 70, 56, 0.14);
  }

  .gf-contact__links a:hover {
    color: #9d5849;
  }

  .gf-contact__form {
    border: 1px solid rgba(47, 70, 56, 0.16);
    border-radius: 8px;
    padding: 28px;
    background: #fffcf6;
  }

  .gf-contact__form form {
    display: grid;
    gap: 12px;
  }

  .gf-contact__form label {
    font-weight: 700;
  }

  .gf-contact__form input,
  .gf-contact__form textarea {
    width: 100%;
    border: 1px solid rgba(47, 70, 56, 0.22);
    border-radius: 8px;
    padding: 12px 14px;
    background: #fff;
    color: #2e2a24;
  }

  .gf-contact__form button {
    justify-self: start;
    min-height: 46px;
    border: 0;
    border-radius: 999px;
    padding: 0 20px;
    color: #faf7f1;
    background: #2f4638;
    font-weight: 700;
    cursor: pointer;
  }

  .gf-contact__success {
    margin: 0;
    color: #2f4638;
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .gf-contact__body {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
